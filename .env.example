# Chatbot widget config. These are PUBLIC (shipped in the frontend bundle) —
# the client key is a publishable identifier, not a secret. Security is enforced
# server-side by the chatbot-server's origin allowlist + rate limiting.
#
# Copy to .env.local and fill in. Restart `npm run dev` after changes.

VITE_CHATBOT_ENDPOINT=https://chat.yourdomain.com/v1/chat
VITE_CHATBOT_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
